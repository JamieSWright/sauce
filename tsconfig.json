{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node", "@cucumber/cucumber"]
  },
  "include": ["features/**/*.ts", "support/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
